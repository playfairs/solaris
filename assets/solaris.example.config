# Solaris Terminal Emulator Configuration
# Copy this file to ~/.config/solaris/config and customize

# Font Settings
font_family = "SF Mono"
font_size = 14

# Background Image (set to a path or leave commented for default)
# background_image = "/Users/username/Pictures/saturn.png"

# Background overlay opacity (0.0 to 1.0) - adds a dark overlay behind text
background_overlay_opacity = 0.15

# Shell to use (defaults to $SHELL environment variable if not set)
shell = "/bin/zsh"

# Window Padding in pixels
padding = 8

# Initial Window Size (in characters)
cols = 80
rows = 24

# Initial Window Size (in pixels)
window_width = 1200
window_height = 800
